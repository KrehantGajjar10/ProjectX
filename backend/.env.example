# Project configuration
PROJECT_NAME="ProjectX Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & Auth
SECRET_KEY="generate-a-secure-32-byte-hex-string-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database (PostgreSQL 17)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="projectx"
POSTGRES_PASSWORD="projectx_secret"
POSTGRES_DB="projectx"
# If DATABASE_URL is set, it overrides the components above
DATABASE_URL="postgresql+asyncpg://projectx:projectx_secret@localhost:5432/projectx"
TEST_DATABASE_URL="postgresql+asyncpg://projectx:projectx_secret@localhost:5432/projectx_test"

# CORS (JSON array of allowed origins)
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'

# Vector Store (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""

# Graph Database (Neo4j - optional, disabled by default)
NEO4J_ENABLED=false
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="projectx_secret"

# LLM Integration (Gemini via google-genai)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_MAX_RETRIES=3
GEMINI_CONCURRENCY_LIMIT=5
EXTRACTION_BATCH_SIZE=5
EXTRACTION_VERSION="v1.0"

# External Integrations
GITHUB_ACCESS_TOKEN=""

# Storage & Uploads
STORAGE_DIR="data/storage"
MAX_UPLOAD_SIZE_BYTES=26214400

# Ingestion & Chunking
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=150
INGESTION_WORKER_POLL_INTERVAL_SECONDS=2.0
INGESTION_STUCK_TIMEOUT_SECONDS=900
GITHUB_MAX_FILE_SIZE_BYTES=1048576
GITHUB_MAX_FILES=500
